# Hébergement Apache : type MIME du GeoJSON et compression des fichiers texte.
# (Ignoré par les autres hébergeurs ; voir README pour nginx, Netlify, GitHub Pages…)
AddType application/geo+json .geojson
AddType text/csv .csv

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/geo+json text/csv image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/geo+json text/csv image/svg+xml
</IfModule>
